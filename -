components:
  schemas:
    Account:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        parent_code:
          type: string
          readOnly: true
          nullable: true
        code:
          type: string
          readOnly: true
        nom:
          type: string
          maxLength: 200
        type:
          $ref: '#/components/schemas/Type568Enum'
        niveau:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
        solde_actuel:
          type: string
          format: decimal
          pattern: ^-?\d{0,14}(?:\.\d{0,2})?$
        est_actif:
          type: boolean
          title: Actif
        parent:
          type: integer
          nullable: true
          title: Compte parent
      required:
      - code
      - id
      - nom
      - parent_code
      - type
    AccountCreate:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        code:
          type: string
          maxLength: 10
        nom:
          type: string
          maxLength: 200
        type:
          $ref: '#/components/schemas/Type568Enum'
        niveau:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
        solde_actuel:
          type: string
          format: decimal
          pattern: ^-?\d{0,14}(?:\.\d{0,2})?$
        est_actif:
          type: boolean
          title: Actif
        parent:
          type: integer
          nullable: true
          title: Compte parent
      required:
      - code
      - id
      - nom
      - type
    ActionEnum:
      enum:
      - CREATE
      - UPDATE
      - DELETE
      - LOGIN
      - STATUS_CHANGE
      - PAYMENT
      - ASSIGN
      type: string
      description: |-
        * `CREATE` - Création
        * `UPDATE` - Modification
        * `DELETE` - Suppression
        * `LOGIN` - Connexion
        * `STATUS_CHANGE` - Changement de statut
        * `PAYMENT` - Paiement
        * `ASSIGN` - Assignation
    Agent:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        user:
          allOf:
          - $ref: '#/components/schemas/User'
          readOnly: true
        matricule:
          type: string
          maxLength: 50
        region:
          type: string
          maxLength: 100
      required:
      - id
      - matricule
      - region
      - user
    AgentCreate:
      type: object
      properties:
        user_id:
          type: integer
          writeOnly: true
        matricule:
          type: string
          maxLength: 50
        region:
          type: string
          maxLength: 100
      required:
      - matricule
      - region
      - user_id
    AmortizationSchedule:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        mensualite:
